# City Configuration (Default: Lahore, Pakistan)
TARGET_CITY=Lahore
CITY_LATITUDE=31.5204
CITY_LONGITUDE=74.3587
CITY_TIMEZONE=Asia/Karachi

# Groq LLM API Key (Free tier available at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hopsworks Feature Store (Free tier available at app.hopsworks.ai)
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=AgentWeather

# Optional secondary APIs for multi-source fusion
OPENWEATHER_API_KEY=
AQICN_API_KEY=

# Drift Detection Thresholds
DATA_DRIFT_PVALUE_THRESHOLD=0.05
MODEL_DRIFT_ERROR_INCREASE_PCT=0.25

